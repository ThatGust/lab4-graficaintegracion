[general]
project_name=IntegracionFinal
autocomp_extra=OpenGL_gl OpenGL_glu OpenGL_glut
active_configuration=Debug_Win32
custom_tabs=0
tab_use_spaces=0
use_wxfb=0
current_source=IntegracionFinal.cpp
[source]
path=IntegracionFinal.cpp
cursor=0
open=true
[config]
name=Debug_Win32
working_folder=
always_ask_args=0
args=
wait_for_key=1
temp_folder=debug.w32
output_file=IntegracionFinal.exe
compiling_extra=
macros=FREEGLUT_STATIC
warnings_level=1
ansi_compliance=0
debug_level=2
optimization_level=0
headers_dirs=${MINGW_DIR}\OpenGl\include
linking_extra=
libraries_dirs=${MINGW_DIR}\OpenGl\lib
libraries=freeglut_static, glu32, opengl32, winmm, gdi32
strip_executable=0
console_program=1
enable_profiling=0
env_vars=PATH+=;${MINGW_DIR}\opengl\bin
[config]
name=Release_Win32
working_folder=
always_ask_args=0
args=
wait_for_key=1
temp_folder=release.w32
output_file=IntegracionFinal.exe
compiling_extra=
macros=FREEGLUT_STATIC
warnings_level=2
ansi_compliance=0
debug_level=0
optimization_level=2
headers_dirs=${MINGW_DIR}\OpenGl\include
linking_extra=
libraries_dirs=${MINGW_DIR}\OpenGl\lib
libraries=freeglut_static, glu32, opengl32, winmm, gdi32
strip_executable=1
console_program=1
enable_profiling=0
env_vars=PATH+=;${MINGW_DIR}\opengl\bin
[end]
